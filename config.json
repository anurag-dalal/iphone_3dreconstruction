{
    "dataset_path": "/home/anurag/codes/iphone_3dreconstruction_v2/dataset/bigger___half_office_frames",
    "output_dir": "output/bigger___half_office_frames",
    "save_gifs": true,
    "gif": {
        "frames":     48,
        "fps":        20,
        "width":      640,
        "height":     480,
        "axis":       "y",
        "bg":         [25, 25, 25],
        "point_size": 2.0,
        "elevation":  20.0
    },
    "processing_height": 192,
    "processing_width": 144,
    "backproject": {
        "enabled": true,
        "min_confidence": 1,
        "max_depth": 5.0,
        "output_path": "output_pointcloud.ply"
    },
    "visualize": {
        "enabled": false,
        "window_width": 1280,
        "window_height": 720
    },
    "pipeline":
        {
            "downsample":{ 
                "voxel_downsample": {
                    "enabled": true,
                    "voxel_size": 0.05
                },
                "statistical_outlier_removal": {
                    "enabled": true,
                    "nb_neighbors": 20,
                    "std_ratio": 2.0
                },
                "pass_through_filter": {
                    "enabled": false,
                    "axis": "y",
                    "min_limit": -0.5,
                    "max_limit": 3.0
                },
                "output_path": "downsampled_pointcloud.ply"
            },


            "surface_reconstruction": {
                "poisson_reconstruction": {
                    "enabled": true,
                    "depth": 8,
                    "density_quantile_threshold": 0.01,
                    "verbose": false
                },
                "ball_pivoting": {
                    "enabled": false,
                    "radii": [0.05, 0.1, 0.2]
                },
                "alpha_shapes": {
                    "enabled": false,
                    "alpha": 0.1
                },
                "output_path": "reconstructed_mesh.ply"
            }
        },
    "floor_plan":
        {
            "enabled": true,
            "output_path": "floor_plan.svg",
            "resolution": 0.05,
            "wall_height_min": 0.1,
            "wall_height_max": 3.0,
            "min_vertical_extent": 0.8,
            "min_component_area": 0.5,
            "closing_iterations": 8
        },
    "element_detection":
        {
            "enabled": true,
            "output_path": "architectural_elements.ply",
            "max_planes": 20,
            "min_plane_inliers": 300,
            "plane_distance_threshold": 0.04,
            "normal_vertical_threshold": 0.85,
            "normal_horizontal_threshold": 0.30,
            "wall_resolution": 0.05,
            "min_opening_area": 0.15,
            "min_door_width": 0.60,
            "max_door_width": 1.80,
            "min_door_height": 1.70,
            "mesh_output_path": "architectural_elements_mesh.ply",
            "mesh_max_edge": 0.30,
            "opening_offset": 0.01
        }
}